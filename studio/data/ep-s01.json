  "subtitles": [
    { "from": 0, "to": 120, "text": "正しいこと、全部やった。" },
    { "from": 120, "to": 360, "text": "なのに、何も変わらなかった。" },
    { "from": 360, "to": 600, "text": "197冊、読んだ。線を引いて、5時に起きて。" },
    { "from": 600, "to": 840, "text": "ずっと、追いかけていた。" },
    { "from": 840, "to": 1080, "text": "欲しいものほど、遠ざかっていく。" },
    { "from": 1080, "to": 1260, "text": "ある夜、198冊目を、開けなかった。" },
    { "from": 1260, "to": 1440, "text": "追うのを、やめた、その夜に──" }
  ],
  "endLine": "手放した瞬間に、来る。",
  "endLineFrom": 1440,
  "endCta": "つづきは、—",
