# --- 生成レイヤーの APIキー（このファイルを .env にコピーして値を入れる）---

# fal.ai（画像生成＋img2video の両方をここ1つで叩く）
# 取得: https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs（日本語ナレーション v3）
# 取得: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# 使うナレーター声のID（ElevenLabs の Voice Library で選んで固定）
ELEVENLABS_VOICE_ID=
